# ---------------------------------------------------------------------------
# Variables de entorno de UniReserve.
#
#   cp .env.example .env
#
# Este archivo SI se versiona. El .env real NO (esta en .gitignore).
# ---------------------------------------------------------------------------

# --- PostgreSQL (usado por docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unireserve

# --- Backend ---
# Sin Docker, el host es localhost. Con Docker Compose, el host es "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unireserve

# Base de datos separada que usan los tests. Se recrea en cada ejecucion.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unireserve_test

# Generar una clave real con:  openssl rand -hex 32
JWT_SECRET=clave-local-de-desarrollo-no-usar-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Carga los datos de prueba al arrancar el contenedor. Debe ser false fuera de local.
RUN_SEED=true

# --- Frontend ---
# Vite la lee en tiempo de compilacion, no de ejecucion.
VITE_API_URL=http://localhost:8000
